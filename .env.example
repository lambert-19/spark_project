# Copier ce fichier en .env puis compléter les valeurs.  (cp .env.example .env)

# --- PostgreSQL ---
POSTGRES_USER=mastodon
POSTGRES_PASSWORD=mastodon
POSTGRES_DB=mastodon
# 5433 côté hôte : le 5432 est souvent pris par un PostgreSQL installé localement
POSTGRES_HOST_PORT=5433

# --- Jupyter ---
JUPYTER_TOKEN=mastodon

# --- Kafka ---
KAFKA_TOPIC=mastodon_stream
# Depuis la machine hôte (producer lancé avec uv) : 127.0.0.1:9094
# Depuis un conteneur : kafka:9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094

# --- Mastodon API ---
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=
# Hashtags suivis, séparés par des virgules (sans #). Liste triée par activité mesurée
# sur mastodon.social le 09/10/2026 (~300 toots distincts/h collectés) ; les 6 hashtags testés
# sans aucun toot (spark, pytorch, jupyter, tensorflow, apachespark, julialang) sont exclus.
MASTODON_HASHTAGS=cybersecurity,infosec,ai,tech,technology,linux,software,coding,apple,opensource,security,science,google,artificialintelligence,microsoft,startup,privacy,llm,python,openai,programming,webdev,anthropic,javascript,devops,aws,foss,math,claude,machinelearning,chatgpt,research,statistics,internet,innovation,cloud,rust,softwareengineering,automation,ethics,datascience,typescript,kubernetes,genai,data,java,postgresql,rstats,robotics,iot,database,mathematics,docker,generativeai,llms,digital,postgres,mistral,dataviz,sql,golang,analytics,aiethics,huggingface,ml,nlp,kafka,dataengineering,bigdata,quantumcomputing,deeplearning,computervision,visualization,pandas

# --- Producer ---
# auto = streaming si MASTODON_ACCESS_TOKEN est renseigné, sinon polling
PRODUCER_MODE=auto
# Secondes entre deux passages en mode polling
PRODUCER_POLL_INTERVAL=30
# Pages d'historique (40 toots) récupérées par hashtag au démarrage
PRODUCER_BACKFILL_PAGES=5

# --- Job de streaming Spark ---
# Langues retenues pour les agrégats (vide = toutes) ; la table brute garde toutes les langues
STREAM_LANGUAGES=en
# Mots-clés optionnels (séparés par des virgules) pour filtrer les agrégats
STREAM_KEYWORDS=
STREAM_WATERMARK=1 hour
STREAM_TRIGGER=10 seconds
